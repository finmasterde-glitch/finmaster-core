# Claude API
CLAUDE_API_KEY=sk-ant-api03-YOUR_KEY_HERE

# Telegram
TELEGRAM_BOT_TOKEN=YOUR_BOT_TOKEN_HERE
# Постоянный домен проекта на Vercel, без слэша на конце
# (например https://finmaster-core.vercel.app) - нужен только для set-webhook.js
WEBHOOK_BASE_URL=https://your-project.vercel.app

# Affiliate Portal
AFFILIATE_PORTAL_URL=https://www.tarifcheck.com/sBobMFe
COMMISSION_PER_SALE=30

# Собственный сайт (форма партнёра + чат вместе) - Telegram-бот ведёт сюда,
# а не напрямую на AFFILIATE_PORTAL_URL, чтобы пользователь сразу попадал
# в среду с переводом/объяснениями рядом с формой, а не на голую немецкую
# форму без контекста
SITE_URL=https://fintik.de

NODE_ENV=production
PORT=3000
